{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "noImplicitThis": false,
    "esModuleInterop": true,
    "target": "ES2020",
    "moduleResolution": "bundler",
    "module": "ESNext",
    "lib": [
      "esnext",
      "dom",
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "src/**/*"
  ]
}